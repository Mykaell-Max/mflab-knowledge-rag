# Credenciais HTTPS somente leitura do GitLab.
MFLAB_GIT_USERNAME=
MFLAB_GIT_READ_TOKEN=

# Banco local via socket Unix e autenticação peer.
MFLAB_DATABASE_URL=postgresql:///mflab_knowledge

# Necessária para habilitar acesso autenticado pela rede local.
MFLAB_API_KEY=

# Opcional: chave exigida apenas pelo servidor LLM local configurado.
MFLAB_LLM_API_KEY=
